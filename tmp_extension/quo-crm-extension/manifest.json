{
  "manifest_version": 3,
  "name": "Donut",
  "version": "1.6.1",
  "description": "Capture selected text from quo.com chats and create CRM leads without leaving the page. by Pastry Marketing.",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "https://quo.com/*",
    "https://*.quo.com/*",
    "https://geocoding.geo.census.gov/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://quo.com/*",
        "https://*.quo.com/*"
      ],
      "all_frames": true,
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://marshmallow-crm.lovable.app/*",
        "https://account-boosters-crm.lovable.app/*",
        "http://localhost:*/*",
        "https://localhost:*/*"
      ],
      "js": [
        "crm-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Open Donut"
  }
}
